{
  "name": "a0-languages",
  "displayName": "A0 languages",
  "description": "Editor support for languages built on A0: diagnostics, highlighting, outline, go to definition and hover from each language's `lsp` command, and debugging from its `dap` command.",
  "version": "0.9.0",
  "publisher": "a0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dan-k391/a0",
    "directory": "editors/vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "b0",
        "aliases": ["B0"],
        "extensions": [".b0"],
        "configuration": "./slash-comments.json"
      },
      {
        "id": "lox",
        "aliases": ["Lox"],
        "extensions": [".lox"],
        "configuration": "./slash-comments.json"
      },
      {
        "id": "minnow",
        "aliases": ["Minnow"],
        "extensions": [".mn"],
        "configuration": "./slash-comments.json"
      },
      {
        "id": "kaleidoscope",
        "aliases": ["Kaleidoscope"],
        "extensions": [".k"],
        "configuration": "./hash-comments.json"
      },
      {
        "id": "tin",
        "aliases": ["Tin"],
        "extensions": [".tin"],
        "configuration": "./slash-comments.json"
      }
    ],
    "breakpoints": [
      { "language": "b0" },
      { "language": "lox" },
      { "language": "minnow" },
      { "language": "kaleidoscope" },
      { "language": "tin" }
    ],
    "debuggers": [
      {
        "type": "a0",
        "label": "A0",
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "The program to debug.", "default": "${file}" },
              "args": { "type": "array", "items": { "type": "string" }, "description": "Its arguments.", "default": [] },
              "stopOnEntry": { "type": "boolean", "description": "Stop at its first line.", "default": false }
            }
          }
        },
        "initialConfigurations": [
          { "type": "a0", "request": "launch", "name": "Debug the current file", "program": "${file}" }
        ],
        "configurationSnippets": [
          {
            "label": "A0: debug the current file",
            "body": { "type": "a0", "request": "launch", "name": "Debug the current file", "program": "^\"\\${file}\"" }
          }
        ]
      }
    ],
    "semanticTokenScopes": [
      { "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } },
      { "language": "b0", "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } },
      { "language": "lox", "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } },
      { "language": "minnow", "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } },
      { "language": "kaleidoscope", "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } },
      { "language": "tin", "scopes": { "keyword": ["keyword.control"], "comment": ["comment"], "string": ["string"], "number": ["constant.numeric"], "operator": ["keyword.operator"] } }
    ],
    "configuration": {
      "title": "A0 languages",
      "properties": {
        "a0.languages": {
          "type": "array",
          "description": "Languages to start a language server for. `command` is the language's driver (run as `command lsp`, or with `args` instead of `lsp`); `extensions` match files by name, `language` by VS Code language id. `${workspaceFolder}` in `command` and `args` is the folder of the file.",
          "items": {
            "type": "object",
            "properties": {
              "language": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" } },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["command"]
          },
          "default": [
            { "language": "b0", "extensions": [".b0"], "command": "b0" },
            { "language": "lox", "extensions": [".lox"], "command": "lox" },
            { "language": "minnow", "extensions": [".mn"], "command": "minnow" },
            { "language": "kaleidoscope", "extensions": [".k"], "command": "kaleidoscope" },
            { "language": "tin", "extensions": [".tin"], "command": "tin" }
          ]
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
