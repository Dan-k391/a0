// Arrays: the primes below 2,000,000 by the sieve of Eratosthenes, ten times.
fn count_primes(n: int) -> int {
  let composite = filled(n + 1, false);
  let count = 0;
  let p = 2;
  while p <= n {
    if !composite[p] {
      count = count + 1;
      let m = p * p;
      while m <= n {
        composite[m] = true;
        m = m + p;
      }
    }
    p = p + 1;
  }
  return count;
}

fn main() {
  let total = 0;
  let round = 0;
  while round < 10 {
    total = total + count_primes(2000000);
    round = round + 1;
  }
  print(total);
}
