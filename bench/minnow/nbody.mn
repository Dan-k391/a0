// Floating point: the Benchmarks Game's n-body, five bodies for 1,000,000 steps.
import std.math;
import std.str;

struct Body { x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float }

fn energy(bodies: [Body]) -> float {
  let e = 0.0;
  let i = 0;
  while i < len(bodies) {
    let b = bodies[i];
    e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
    let j = i + 1;
    while j < len(bodies) {
      let c = bodies[j];
      let dx = b.x - c.x;
      let dy = b.y - c.y;
      let dz = b.z - c.z;
      e = e - b.mass * c.mass / math.sqrt(dx * dx + dy * dy + dz * dz);
      j = j + 1;
    }
    i = i + 1;
  }
  return e;
}

fn advance(bodies: [Body], dt: float) {
  let i = 0;
  while i < len(bodies) {
    let b = bodies[i];
    let j = i + 1;
    while j < len(bodies) {
      let c = bodies[j];
      let dx = b.x - c.x;
      let dy = b.y - c.y;
      let dz = b.z - c.z;
      let d2 = dx * dx + dy * dy + dz * dz;
      let mag = dt / (d2 * math.sqrt(d2));
      b.vx = b.vx - dx * c.mass * mag;
      b.vy = b.vy - dy * c.mass * mag;
      b.vz = b.vz - dz * c.mass * mag;
      c.vx = c.vx + dx * b.mass * mag;
      c.vy = c.vy + dy * b.mass * mag;
      c.vz = c.vz + dz * b.mass * mag;
      j = j + 1;
    }
    i = i + 1;
  }
  for b in bodies {
    b.x = b.x + dt * b.vx;
    b.y = b.y + dt * b.vy;
    b.z = b.z + dt * b.vz;
  }
}

fn main() {
  let pi = 3.141592653589793;
  let solar_mass = 4.0 * pi * pi;
  let dpy = 365.24;
  let bodies = [
    new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass },
    new Body { x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109,
      vx: 0.00166007664274403694 * dpy, vy: 0.00769901118419740425 * dpy,
      vz: -0.0000690460016972063023 * dpy, mass: 0.000954791938424326609 * solar_mass },
    new Body { x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381,
      vx: -0.00276742510726862411 * dpy, vy: 0.00499852801234917238 * dpy,
      vz: 0.0000230417297573763929 * dpy, mass: 0.000285885980666130812 * solar_mass },
    new Body { x: 12.8943695621391310, y: -15.1111514016986312, z: -0.223307578892655734,
      vx: 0.00296460137564761618 * dpy, vy: 0.00237847173959480950 * dpy,
      vz: -0.0000296589568540237556 * dpy, mass: 0.0000436624404335156298 * solar_mass },
    new Body { x: 15.3796971148509165, y: -25.9193146099879641, z: 0.179258772950371181,
      vx: 0.00268067772490389322 * dpy, vy: 0.00162824170038242295 * dpy,
      vz: -0.0000951592254519715870 * dpy, mass: 0.0000515138902046611451 * solar_mass }
  ];
  let px = 0.0;
  let py = 0.0;
  let pz = 0.0;
  for b in bodies {
    px = px + b.vx * b.mass;
    py = py + b.vy * b.mass;
    pz = pz + b.vz * b.mass;
  }
  bodies[0].vx = 0.0 - px / solar_mass;
  bodies[0].vy = 0.0 - py / solar_mass;
  bodies[0].vz = 0.0 - pz / solar_mass;
  print(str.fixed(energy(bodies), 9));
  let n = 0;
  while n < 1000000 {
    advance(bodies, 0.01);
    n = n + 1;
  }
  print(str.fixed(energy(bodies), 9));
}
