// Floating point: the Benchmarks Game's n-body, five bodies for 1,000,000 steps, as structs in
// memory reached through pointers.
struct Body { x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, mass: f64 }

extern fn sqrt(x: f64) -> f64;

fn energy(bodies: *Body) -> f64 {
  var e = 0.0;
  for (var i = 0; i < 5; i += 1) {
    var b = &bodies[i];
    e += 0.5 * b->mass * (b->vx * b->vx + b->vy * b->vy + b->vz * b->vz);
    for (var j = i + 1; j < 5; j += 1) {
      var c = &bodies[j];
      var dx = b->x - c->x;
      var dy = b->y - c->y;
      var dz = b->z - c->z;
      e -= b->mass * c->mass / sqrt(dx * dx + dy * dy + dz * dz);
    }
  }
  return e;
}

fn advance(bodies: *Body, dt: f64) {
  for (var i = 0; i < 5; i += 1) {
    var b = &bodies[i];
    for (var j = i + 1; j < 5; j += 1) {
      var c = &bodies[j];
      var dx = b->x - c->x;
      var dy = b->y - c->y;
      var dz = b->z - c->z;
      var d2 = dx * dx + dy * dy + dz * dz;
      var mag = dt / (d2 * sqrt(d2));
      b->vx -= dx * c->mass * mag;
      b->vy -= dy * c->mass * mag;
      b->vz -= dz * c->mass * mag;
      c->vx += dx * b->mass * mag;
      c->vy += dy * b->mass * mag;
      c->vz += dz * b->mass * mag;
    }
  }
  for (var i = 0; i < 5; i += 1) {
    var b = &bodies[i];
    b->x += dt * b->vx;
    b->y += dt * b->vy;
    b->z += dt * b->vz;
  }
}

// What C's printf("%.9f") prints for these energies.
fn print_fixed9(x: f64) {
  if (x < 0.0) {
    print("-");
    x = -x;
  }
  var scaled = (x * 1000000000.0 + 0.5) as i64;
  print(scaled / 1000000000, ".");
  var frac = scaled % 1000000000;
  for (var d = 100000000; d > 0; d /= 10) { print(frac / d % 10); }
  println();
}

fn main() -> i32 {
  var pi = 3.141592653589793;
  var solar_mass = 4.0 * pi * pi;
  var dpy = 365.24;
  var bodies = alloc(sizeof(Body) * 5) as *Body;
  bodies[0] = (Body){ .mass = solar_mass };
  bodies[1] = (Body){ .x = 4.84143144246472090, .y = -1.16032004402742839, .z = -0.103622044471123109,
    .vx = 0.00166007664274403694 * dpy, .vy = 0.00769901118419740425 * dpy,
    .vz = -0.0000690460016972063023 * dpy, .mass = 0.000954791938424326609 * solar_mass };
  bodies[2] = (Body){ .x = 8.34336671824457987, .y = 4.12479856412430479, .z = -0.403523417114321381,
    .vx = -0.00276742510726862411 * dpy, .vy = 0.00499852801234917238 * dpy,
    .vz = 0.0000230417297573763929 * dpy, .mass = 0.000285885980666130812 * solar_mass };
  bodies[3] = (Body){ .x = 12.8943695621391310, .y = -15.1111514016986312, .z = -0.223307578892655734,
    .vx = 0.00296460137564761618 * dpy, .vy = 0.00237847173959480950 * dpy,
    .vz = -0.0000296589568540237556 * dpy, .mass = 0.0000436624404335156298 * solar_mass };
  bodies[4] = (Body){ .x = 15.3796971148509165, .y = -25.9193146099879641, .z = 0.179258772950371181,
    .vx = 0.00268067772490389322 * dpy, .vy = 0.00162824170038242295 * dpy,
    .vz = -0.0000951592254519715870 * dpy, .mass = 0.0000515138902046611451 * solar_mass };
  var px = 0.0;
  var py = 0.0;
  var pz = 0.0;
  for (var i = 0; i < 5; i += 1) {
    px += bodies[i].vx * bodies[i].mass;
    py += bodies[i].vy * bodies[i].mass;
    pz += bodies[i].vz * bodies[i].mass;
  }
  bodies[0].vx = -px / solar_mass;
  bodies[0].vy = -py / solar_mass;
  bodies[0].vz = -pz / solar_mass;
  print_fixed9(energy(bodies));
  for (var n = 0; n < 1000000; n += 1) { advance(bodies, 0.01); }
  print_fixed9(energy(bodies));
  free(bodies);
  return 0;
}
