// Functions, variables, loops and conditions.
fn square(x: int) -> int {
  return x * x;
}

fn describe(n: int) -> string {
  if n > 10 {
    return "big";
  } else if n > 5 {
    return "medium";
  }
  return "small";
}

fn main() {
  let total = 0;
  let i = 1;
  while i <= 3 {
    total = total + square(i);
    i = i + 1;
  }
  print(total);
  print(describe(total));
  print("pi is about " + str(3.14159));
  print(total > 10 && !(total == 13));
}
// expect: 14
// expect: big
// expect: pi is about 3.14159
// expect: true
