// The program's arguments and environment.
module "std.env";

extern "a0" fn a0_std_args() -> array<string>;
extern fn getenv(string) -> string?;

// The arguments the program was started with, without the program itself.
fn args() -> array<string> {
  a0_std_args()
}

// The value of an environment variable, or null if it is not set.
fn get(name: string) -> string? {
  getenv(name)
}
