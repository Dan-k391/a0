// The HIR text format (docs/hir.md). The @prec table below is mirrored by the printer's precedence
// levels in print.rs; change both together.
grammar hir;

skip /[ \t\r\n]+/;
skip /\/\/[^\n]*/;
token FLOAT /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+/;
token INT /[0-9]+/;
token HEX /0x[0-9a-fA-F]+/;
token STRING /"([^"\\\n]|\\.)*"/;
// Names that are keywords, or not identifiers, are written in backquotes: `map`.
token NAME /[A-Za-z_][A-Za-z0-9_]*|`[^`\n]+`/;
error "unterminated string" /"([^"\\\n]|\\.)*/;
unknown "unexpected character";

module = "module" name:STRING ~ "expected the module name as a string" ";" ~ "expected ';'"
         (!EOF item)* EOF;

item @inline @recover(before "struct" "enum" "interface" "impl" "global" "extern" "fn")
    = struct_decl | enum_decl | interface_decl | impl_decl | global_decl | extern_decl | fn_decl;

struct_decl = "struct" name:NAME ~ "expected a struct name" type_params? "{" ~ "expected '{'"
              (field ("," field)* ","?)? "}" ~ "expected '}'";
field = name:NAME ":" ~ "expected ':'" type:type ~ "expected a type";

enum_decl = "enum" name:NAME ~ "expected an enum name" type_params? "{" ~ "expected '{'"
            (variant ("," variant)* ","?)? "}" ~ "expected '}'";
variant = name:NAME ("(" type:type ("," type:type)* ")" ~ "expected ')'")?;

interface_decl = "interface" name:NAME ~ "expected an interface name" "{" ~ "expected '{'"
                 method:method_sig* "}" ~ "expected '}'";
method_sig = "fn" name:NAME ~ "expected a method name" "(" ~ "expected '('" receiver:NAME ~ "expected 'self'"
             ("," param_type:type ~ "expected a type")* ")" ~ "expected ')'" ("->" ret:type)?
             ";" ~ "expected ';'";

// `impl Shape for Circle;` declares an implementation; `impl<T> Cell<T> { fn ... }` holds methods,
// whose first parameter is the value they are called on.
impl_decl = "impl" type_params? owner:impl_type ~ "expected a type"
            ("for" target:impl_type ~ "expected a type" ";" ~ "expected ';'"
             | "{" ~ "expected '{' or 'for'" method:fn_decl* "}" ~ "expected '}'");
impl_type = name:NAME type_args? | "int" | "float" | "bool" | "string";

global_decl = "global" name:NAME ~ "expected a global name" ":" ~ "expected ':'"
              type:type ~ "expected a type" ";" ~ "expected ';'";

extern_decl = "extern" abi:STRING? "fn" ~ "expected 'fn'" name:NAME ~ "expected a function name"
              "(" ~ "expected '('" (param_type:type ("," param_type:type)*)? ")" ~ "expected ')'"
              ("->" ret:type)? ";" ~ "expected ';'";

fn_decl = "fn" name:NAME ~ "expected a function name" type_params? "(" ~ "expected '('"
          (param ("," param)*)? ")" ~ "expected ')'" ("->" ret:type)?
          body:block ~ "expected a function body";
param = name:NAME ":" ~ "expected ':'" type:type ~ "expected a type";
type_params = "<" tparam:type_param ~ "expected a type parameter"
              ("," tparam:type_param ~ "expected a type parameter")* ">" ~ "expected '>'";
type_param = name:NAME (":" bound:NAME ~ "expected an interface" ("+" bound:NAME ~ "expected an interface")*)?;

type = base:base_type nullable:"?"?;
base_type = "unit" | "bool" | "int" | "float" | "string" | "any" | "never"
     | "array" "<" ~ "expected '<'" elem:type ">" ~ "expected '>'"
     | "map" "<" ~ "expected '<'" key:type "," ~ "expected ','" value:type ">" ~ "expected '>'"
     | "fn" "(" ~ "expected '('" (param_type:type ("," param_type:type)*)? ")" ~ "expected ')'" ("->" ret:type)?
     | "(" inner:type ")" ~ "expected ')'"
     | name:NAME type_args?;
type_args = "<" targ:type ~ "expected a type" ("," targ:type ~ "expected a type")* ">" ~ "expected '>'";

block = "{" stmt* tail:expr? "}" ~ "expected '}'";
stmt @inline = let_stmt | expr_stmt | blocklike_stmt;
let_stmt = "let" name:NAME ~ "expected a name" (":" type:type)? "=" ~ "expected '='"
           value:expr ";" ~ "expected ';'";
expr_stmt = e:expr ";";
blocklike_stmt = e:blocklike !"}";
blocklike @inline = if_expr | while_expr | loop_expr | match_expr | try_expr | block;

expr @inline = @prec primary ~ "expected an expression" {
    right "=" => assign;
    left "||" => or;
    left "&&" => and;
    left "==" "!=" => binary;
    left "<" "<=" ">" ">=" => binary;
    left "+" "-" => binary;
    left "*" "/" "%" => binary;
    postfix "as" ty:type ~ "expected a type" => cast;
    postfix "is" ty:type ~ "expected a type" => is;
    prefix "-" "!" => unary;
    postfix "(" args:args? ")" ~ "expected ')'" => call;
    postfix "!" => unwrap;
    postfix "." name:NAME ~ "expected a field name" => field;
    postfix "[" index:expr "]" ~ "expected ']'" => index;
};

args = arg:expr ("," arg:expr)*;

primary = unit_lit | paren | literal | float_bits | null_lit | new_expr | array_lit | variant_expr | lambda
        | if_expr | while_expr | loop_expr | match_expr | try_expr | block
        | break_expr | continue_expr | return_expr | throw_expr | name_expr;

unit_lit = "(" ")";
paren = "(" inner:expr ")" ~ "expected ')'";
literal = "true" | "false" | INT | FLOAT | STRING;
float_bits = "float_bits" "(" ~ "expected '('" bits:HEX ~ "expected hex bits" ")" ~ "expected ')'";
null_lit = "null" "<" ~ "expected '<'" type:type ">" ~ "expected '>'";
new_expr = "new" ~ "expected 'new'" (new_struct | new_collection);
new_struct = name:NAME type_args? "{" ~ "expected '{'" (field_init ("," field_init)* ","?)? "}" ~ "expected '}'";
field_init = name:NAME ":" ~ "expected ':'" value:expr;
new_collection = type:type;
array_lit = "[" args:args? "]" ~ "expected ']'";
variant_expr = enum:NAME type_args? "::" name:NAME ~ "expected a variant name" ("(" args:args? ")" ~ "expected ')'")?;
lambda = "fn" "(" ~ "expected '('" (param ("," param)*)? ")" ~ "expected ')'" ("->" ret:type)?
         body:block ~ "expected a closure body";
if_expr = "if" ("let" bind:NAME ~ "expected a name" "=" ~ "expected '='" value:expr | cond:expr)
          ~ "expected a condition" then:block ~ "expected '{'"
          ("else" (else:if_expr | else:block) ~ "expected '{' or if")?;
while_expr = "while" cond:expr ~ "expected a condition" body:block ~ "expected '{'";
loop_expr = "loop" body:block ~ "expected '{'";
match_expr = "match" scrutinee:expr ~ "expected an expression" "{" ~ "expected '{'"
             (arm ("," arm)* ","?)? "}" ~ "expected '}'";
arm = pattern:pattern "=>" ~ "expected '=>'" body:expr ~ "expected an expression";
pattern = "_" | variant:NAME ("(" bind:NAME ("," bind:NAME)* ")" ~ "expected ')'")?;
break_expr = "break";
continue_expr = "continue";
return_expr = "return" value:expr?;
throw_expr = "throw" value:expr ~ "expected an expression";
try_expr = "try" body:block ~ "expected '{'" "catch" ~ "expected 'catch'" bind:NAME ~ "expected a name"
           handler:block ~ "expected '{'";
name_expr = name:NAME ("::" type_args)?;
