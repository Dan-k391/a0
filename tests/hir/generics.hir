// Generic functions, structs and enums, monomorphized by A0, and nullable references.
// expect-stdout: transform 2 4 6 | 1! 2! 3!
// expect-stdout: pair 1 one / two 2
// expect-stdout: first some 10, none
// expect-stdout: list 3 2 1 (3)
// expect-stdout: names 2: ada, bo
// expect-stdout: eq true false true
// expect-stdout: boxed 7 is int: true
// expect-stdout: empty 0 0
// expect-stdout: count 3
// expect-stdout: maybe 5 nothing
module "generics";

struct Pair<A, B> { first: A, second: B }
struct Cell<T> { head: T, tail: Cell<T>? }
enum Option<T> { Some(T), None }

fn transform<T, U>(xs: array<T>, f: fn(T) -> U) -> array<U> {
  let out = new array<U>;
  let i = 0;
  while i < len(xs) {
    push(out, f(xs[i]));
    i = i + 1;
  }
  out
}

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
  new Pair<B, A> { first: p.second, second: p.first }
}

fn first<T>(xs: array<T>) -> Option<T> {
  if len(xs) == 0 { Option::None } else { Option::Some(xs[0]) }
}

fn cons<T>(head: T, tail: Cell<T>?) -> Cell<T> {
  new Cell { head: head, tail: tail }
}

fn length<T>(c: Cell<T>?) -> int {
  if c == null<Cell<T>> { 0 } else { 1 + length(c!.tail) }
}

fn same<T>(a: T, b: T) -> bool {
  a == b
}

fn empty<T>() -> array<T> {
  new array<T>
}

// A closure inside a generic function captures a value of the type parameter.
fn counter<T>(item: T) -> fn() -> int {
  let n = 0;
  fn() -> int {
    let keep = item;
    n = n + 1;
    n
  }
}

fn describe(o: Option<int>) -> string {
  match o {
    Some(v) => "some " + str(v),
    None => "none",
  }
}

fn main() -> int {
  let doubled = transform([1, 2, 3], fn(x: int) -> int { x * 2 });
  let shouted = transform([1, 2, 3], fn(x: int) -> string { str(x) + "!" });
  print("transform " + str(doubled[0]) + " " + str(doubled[1]) + " " + str(doubled[2]) + " | "
    + shouted[0] + " " + shouted[1] + " " + shouted[2] + "\n");

  let p = new Pair { first: 1, second: "one" };
  let q = swap(new Pair { first: 2, second: "two" });
  print("pair " + str(p.first) + " " + p.second + " / " + q.first + " " + str(q.second) + "\n");

  print("first " + describe(first([10, 20])) + ", " + describe(first(empty::<int>())) + "\n");

  let list = cons(3, cons(2, cons(1, null<Cell<int>>)));
  let text = "list";
  let c: Cell<int>? = list;
  while c != null<Cell<int>> {
    text = text + " " + str(c!.head);
    c = c!.tail;
  }
  print(text + " (" + str(length(list)) + ")\n");

  let names = cons("bo", null<Cell<string>>);
  names = cons("ada", names);
  print("names " + str(length(names)) + ": " + names.head + ", " + names.tail!.head + "\n");

  print("eq " + str(same(1, 1)) + " " + str(same("a", "b")) + " " + str(same("x" + "y", "xy")) + "\n");

  let boxed = 7 as any;
  print("boxed " + str(boxed as int) + " is int: " + str(boxed is int) + "\n");

  let none: array<string> = empty();
  print("empty " + str(len(none)) + " " + str(len(empty::<float>())) + "\n");

  let tick = counter("x");
  tick();
  tick();
  print("count " + str(tick()) + "\n");

  let m1: Option<int> = Option::Some(5);
  let m2: Option<int> = Option::None;
  let show = fn(o: Option<int>) -> string {
    match o { Some(v) => str(v), None => "nothing" }
  };
  print("maybe " + show(m1) + " " + show(m2) + "\n");
  0
}
