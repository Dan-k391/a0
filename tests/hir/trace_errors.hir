// Each runtime error says what failed, with the values involved; this one is a panic of the
// program's own, after a substring that is in range and before one that is not.
// expect-stdout: ell
// expect-stderr: panic: substring out of range: 9 bytes from 2, but the length is 5
// expect-stderr:     at cut (tests/hir/trace_errors.hir:11:3)
// expect-stderr:     at main (tests/hir/trace_errors.hir:16:3)
// expect-exit: 101
module "trace_errors";

fn cut(s: string, from: int, count: int) -> string {
  substr(s, from, count)
}

fn main() -> int {
  print(cut("hello", 1, 3) + "\n");
  cut("hello", 2, 9);
  panic("not reached")
}
