// A large structure in several size classes is built and dropped, then the program keeps
// allocating: the chunks the peak left empty are skipped by later collections until they are
// allocated from again, and every cell they hand out must hold only its new object.
// expect-stdout: peak 4095 4798500
// expect-stdout: steady 255000 499500
// expect-exit: 0
module "gc peak";

enum Tree { Leaf, Node(Tree, Tree) }

struct Big { a: int, b: int, c: int, d: int, e: int, f: int, g: any }

fn build(depth: int) -> Tree {
  if depth == 0 { Tree::Leaf } else { Tree::Node(build(depth - 1), build(depth - 1)) }
}

fn count(t: Tree) -> int {
  match t {
    Leaf => 0,
    Node(l, r) => 1 + count(l) + count(r),
  }
}

fn peak() -> int {
  let t = build(12);
  let boxes = new array<any>;
  let bigs = new array<Big>;
  let i = 0;
  while i < 3000 {
    push(boxes, (1125899906842624 + i) as any);
    push(bigs, new Big { a: i, b: i, c: i, d: i, e: i, f: i, g: "x" as any });
    i = i + 1;
  }
  let sum = 0;
  i = 0;
  while i < 3000 {
    sum = sum + (boxes[i] as int - 1125899906842624) + bigs[i].f - i + bigs[i].a - i + 100;
    i = i + 1;
  }
  print("peak " + str(count(t)) + " " + str(sum) + "\n");
  0
}

fn main() -> int {
  peak();
  let total = 0;
  let boxed = 0;
  let round = 0;
  while round < 1000 {
    let t = build(8);
    let b = new Big { a: round, b: 0, c: 0, d: 0, e: 0, f: round, g: (1125899906842624 + round) as any };
    total = total + count(t) + b.a - b.f;
    boxed = boxed + (b.g as int - 1125899906842624);
    round = round + 1;
  }
  print("steady " + str(total) + " " + str(boxed) + "\n");
  0
}
