// Unwrapping a null reference panics with the runtime's message, after flushing earlier output.
// expect-stdout: before
// expect-stderr: panic: unwrapped a `null` value with `!`
// expect-stderr:     at main (tests/hir/panics.hir:13:3)
// expect-exit: 101
module "panics";

struct P { x: int }

fn main() -> int {
  print("before\n");
  let p = null<P>;
  p!.x
}
