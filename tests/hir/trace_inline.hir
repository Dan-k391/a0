// A failure in inlined code shows the inlined functions as frames, so the trace is the same with the
// optimizer on (both helpers are inlined into `main`) and off.
// expect-stdout: 20
// expect-stderr: panic: index out of bounds: the length is 2 but the index is 7
// expect-stderr:     at inner (tests/hir/trace_inline.hir:12:3)
// expect-stderr:     at outer (tests/hir/trace_inline.hir:16:3)
// expect-stderr:     at main (tests/hir/trace_inline.hir:22:13)
// expect-exit: 101
module "trace_inline";

fn inner(xs: array<int>, i: int) -> int {
  xs[i] * 10
}

fn outer(xs: array<int>, i: int) -> int {
  inner(xs, i + 1)
}

fn main() -> int {
  let xs = [1, 2];
  print(str(outer(xs, 0)) + "\n");
  print(str(outer(xs, 6)) + "\n");
  0
}
