// Lox's runtime semantics, written in HIR. The compiler emits calls to these functions; every Lox
// value is an `any`. Error messages and the exit status (70) match jlox.
module "lox";

// A function's code takes the receiver (`()` for plain functions) and the arguments. Functions of up
// to three parameters take them directly (`code0` to `code3`), so most calls build no array; others
// take an array (`code`). Exactly one of the five is set.
struct LoxFunction {
  name: string,
  arity: int,
  code: (fn(any, array<any>) -> any)?,
  code0: (fn(any) -> any)?,
  code1: (fn(any, any) -> any)?,
  code2: (fn(any, any, any) -> any)?,
  code3: (fn(any, any, any, any) -> any)?
}
// A native function's code takes the arguments and the line of the call, for its errors.
struct LoxNative { arity: int, code: fn(array<any>, int) -> any }
// What a Lox `throw` raises: the value, and the line of the `throw` for when nothing catches it.
struct LoxThrown { value: any, line: int }
// A class's methods (`LoxFunction`s) and an instance's fields are dynamic objects, found by name
// through shapes and caches (docs/hir.md, "Dynamic objects").
struct LoxClass { name: string, methods: object }
struct LoxInstance { class: LoxClass, fields: object }
struct LoxBound { receiver: any, method: LoxFunction }

global depth: int;

fn runtime_error(message: string, line: int) -> never {
  eprint(message + "\n[line " + str(line) + "]\n");
  exit(70)
}

// Each Lox global is a HIR global with a flag saying whether it has been defined yet.
fn undefined_variable(name: string, line: int) -> never {
  runtime_error("Undefined variable '" + name + "'.", line)
}

fn native_clock() -> any {
  new LoxNative { arity: 0, code: fn(args: array<any>, line: int) -> any { clock() as any } } as any
}

fn throw_value(value: any, line: int) -> never {
  throw new LoxThrown { value: value, line: line }
}

// The value a `catch` gets.
fn caught(e: any) -> any {
  (e as LoxThrown).value
}

// An exception that nothing caught ends the program like a runtime error.
fn uncaught(e: any) -> never {
  let t = e as LoxThrown;
  runtime_error("Uncaught exception: " + stringify(t.value) + ".", t.line)
}

fn truthy(v: any) -> bool {
  if v is unit { false } else if v is bool { v as bool } else { true }
}

fn numbers(a: any, b: any, line: int) {
  if !(a is float && b is float) {
    runtime_error("Operands must be numbers.", line);
  }
}

// Numbers first and small, so that the optimizer inlines it; strings and errors are rarer.
fn add(a: any, b: any, line: int) -> any {
  if a is float && b is float {
    ((a as float) + (b as float)) as any
  } else {
    add_strings(a, b, line)
  }
}

fn add_strings(a: any, b: any, line: int) -> any {
  if a is string && b is string {
    return ((a as string) + (b as string)) as any;
  }
  runtime_error("Operands must be two numbers or two strings.", line)
}

fn subtract(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) - (b as float)) as any
}

fn multiply(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) * (b as float)) as any
}

fn divide(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) / (b as float)) as any
}

fn less(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) < (b as float)) as any
}

fn less_equal(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) <= (b as float)) as any
}

fn greater(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) > (b as float)) as any
}

fn greater_equal(a: any, b: any, line: int) -> any {
  numbers(a, b, line);
  ((a as float) >= (b as float)) as any
}

fn negate(a: any, line: int) -> any {
  if !(a is float) {
    runtime_error("Operand must be a number.", line);
  }
  (-(a as float)) as any
}

fn stringify(v: any) -> string {
  if v is unit {
    "nil"
  } else if v is bool {
    if v as bool { "true" } else { "false" }
  } else if v is float {
    str(v as float)
  } else if v is string {
    v as string
  } else if v is LoxFunction {
    "<fn " + (v as LoxFunction).name + ">"
  } else if v is LoxBound {
    "<fn " + (v as LoxBound).method.name + ">"
  } else if v is LoxClass {
    (v as LoxClass).name
  } else if v is LoxInstance {
    (v as LoxInstance).class.name + " instance"
  } else {
    "<native fn>"
  }
}

fn print_value(v: any) {
  print(stringify(v) + "\n");
}

fn arity(expected: int, given: int, line: int) {
  if expected != given {
    runtime_error("Expected " + str(expected) + " arguments but got " + str(given) + ".", line);
  }
}

// Counts nested calls: each Lox call is at least two native frames, and the limit keeps deep
// recursion a Lox error rather than a stack overflow of the host.
fn enter(line: int) {
  depth = depth + 1;
  if depth > 3000 {
    runtime_error("Stack overflow.", line);
  }
}

// Runs a function with its arguments in an array.
fn invoke(f: LoxFunction, this: any, args: array<any>, line: int) -> any {
  arity(f.arity, len(args), line);
  if f.arity == 0 {
    f.code0!(this)
  } else if f.arity == 1 {
    f.code1!(this, args[0])
  } else if f.arity == 2 {
    f.code2!(this, args[0], args[1])
  } else if f.arity == 3 {
    f.code3!(this, args[0], args[1], args[2])
  } else {
    f.code!(this, args)
  }
}

// Calls a Lox value with its arguments in an array: functions, methods, classes and natives.
fn call(callee: any, args: array<any>, line: int) -> any {
  call_with(callee, () as any, args, line)
}

// Calls a Lox value found by `find_method` on `receiver`, which a function's code then gets (a
// plain function's code never uses it: only methods refer to `this`).
fn call_with(callee: any, receiver: any, args: array<any>, line: int) -> any {
  enter(line);
  let result: any = if callee is LoxFunction {
    invoke(callee as LoxFunction, receiver, args, line)
  } else if callee is LoxBound {
    let b = callee as LoxBound;
    invoke(b.method, b.receiver, args, line)
  } else if callee is LoxClass {
    let k = callee as LoxClass;
    let instance = new LoxInstance { class: k, fields: new object } as any;
    if has_field(k.methods, "init") {
      invoke(field(k.methods, "init") as LoxFunction, instance, args, line);
    } else {
      arity(0, len(args), line);
    }
    instance
  } else if callee is LoxNative {
    let n = callee as LoxNative;
    arity(n.arity, len(args), line);
    n.code(args, line)
  } else {
    runtime_error("Can only call functions and classes.", line)
  };
  depth = depth - 1;
  result
}

fn call0(callee: any, line: int) -> any {
  call_with0(callee, () as any, line)
}

fn call1(callee: any, a: any, line: int) -> any {
  call_with1(callee, () as any, a, line)
}

fn call2(callee: any, a: any, b: any, line: int) -> any {
  call_with2(callee, () as any, a, b, line)
}

fn call3(callee: any, a: any, b: any, c: any, line: int) -> any {
  call_with3(callee, () as any, a, b, c, line)
}

// Calls with zero to three arguments on a receiver (as `call_with`): functions and methods of that
// arity directly, anything else (classes, natives, wrong arities, errors) through `call_with`.
// Written without early returns so that the optimizer inlines them at each call site.
fn call_with0(callee: any, receiver: any, line: int) -> any {
  if callee is LoxFunction {
    let f = callee as LoxFunction;
    if let code = f.code0 {
      enter(line);
      let r = code(receiver);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, new array<any>, line)
    }
  } else if callee is LoxBound {
    let m = callee as LoxBound;
    if let code = m.method.code0 {
      enter(line);
      let r = code(m.receiver);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, new array<any>, line)
    }
  } else {
    call_with(callee, receiver, new array<any>, line)
  }
}

fn call_with1(callee: any, receiver: any, a: any, line: int) -> any {
  if callee is LoxFunction {
    let f = callee as LoxFunction;
    if let code = f.code1 {
      enter(line);
      let r = code(receiver, a);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a], line)
    }
  } else if callee is LoxBound {
    let m = callee as LoxBound;
    if let code = m.method.code1 {
      enter(line);
      let r = code(m.receiver, a);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a], line)
    }
  } else {
    call_with(callee, receiver, [a], line)
  }
}

fn call_with2(callee: any, receiver: any, a: any, b: any, line: int) -> any {
  if callee is LoxFunction {
    let f = callee as LoxFunction;
    if let code = f.code2 {
      enter(line);
      let r = code(receiver, a, b);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a, b], line)
    }
  } else if callee is LoxBound {
    let m = callee as LoxBound;
    if let code = m.method.code2 {
      enter(line);
      let r = code(m.receiver, a, b);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a, b], line)
    }
  } else {
    call_with(callee, receiver, [a, b], line)
  }
}

fn call_with3(callee: any, receiver: any, a: any, b: any, c: any, line: int) -> any {
  if callee is LoxFunction {
    let f = callee as LoxFunction;
    if let code = f.code3 {
      enter(line);
      let r = code(receiver, a, b, c);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a, b, c], line)
    }
  } else if callee is LoxBound {
    let m = callee as LoxBound;
    if let code = m.method.code3 {
      enter(line);
      let r = code(m.receiver, a, b, c);
      depth = depth - 1;
      r
    } else {
      call_with(callee, receiver, [a, b, c], line)
    }
  } else {
    call_with(callee, receiver, [a, b, c], line)
  }
}

// `object.name`: a field, or a method bound to the object.
fn get_property(object: any, name: string, line: int) -> any {
  if object is LoxInstance {
    let instance = object as LoxInstance;
    if has_field(instance.fields, name) {
      field(instance.fields, name)
    } else {
      new LoxBound { receiver: object, method: method(instance.class, name, line) } as any
    }
  } else {
    runtime_error("Only instances have properties.", line)
  }
}

// What `object.name(...)` calls, found before the arguments are evaluated as in jlox: a field's
// value, or the method itself, which `call_with` then calls on the object. Nothing is bound, so a
// method call allocates nothing (clox's `OP_INVOKE`).
fn find_method(object: any, name: string, line: int) -> any {
  if object is LoxInstance {
    let instance = object as LoxInstance;
    if has_field(instance.fields, name) {
      field(instance.fields, name)
    } else {
      method(instance.class, name, line) as any
    }
  } else {
    runtime_error("Only instances have properties.", line)
  }
}

fn method(k: LoxClass, name: string, line: int) -> LoxFunction {
  if has_field(k.methods, name) {
    field(k.methods, name) as LoxFunction
  } else {
    runtime_error("Undefined property '" + name + "'.", line)
  }
}

// jlox checks the object before it evaluates the value being assigned.
fn check_fields(object: any, line: int) {
  if !(object is LoxInstance) {
    runtime_error("Only instances have fields.", line);
  }
}

fn set_property(object: any, name: string, value: any) -> any {
  set_field((object as LoxInstance).fields, name, value);
  value
}

fn get_super(superclass: any, receiver: any, name: string, line: int) -> any {
  new LoxBound { receiver: receiver, method: method(superclass as LoxClass, name, line) } as any
}

// What `super.name(...)` calls on `this` (see `find_method`).
fn find_super(superclass: any, name: string, line: int) -> any {
  method(superclass as LoxClass, name, line) as any
}

fn check_superclass(superclass: any, line: int) {
  if !(superclass is LoxClass) {
    runtime_error("Superclass must be a class.", line);
  }
}

// Methods are copied down: classes never change after they are created, so this is the same as
// looking them up through the superclass chain.
fn new_class(name: string, superclass: any) -> LoxClass {
  let k = new LoxClass { name: name, methods: new object };
  if superclass is LoxClass {
    let inherited = (superclass as LoxClass).methods;
    let names = field_names(inherited);
    let i = 0;
    while i < len(names) {
      set_field(k.methods, names[i], field(inherited, names[i]));
      i = i + 1;
    }
  }
  k
}
