// Methods, interfaces with dynamic dispatch, and generic functions bounded by interfaces.
interface Shape {
  fn area(self) -> float;
  fn name(self) -> string;
}

interface Ord {
  fn compare(self, other: Self) -> int;
}

struct Circle { r: float }
struct Rect { w: float, h: float }
struct Stack<T> { items: [T] }
enum Light { Off, On(int) }

impl Circle {
  fn grow(self, k: float) -> Circle { return new Circle { r: self.r * k }; }
}

impl Shape for Circle {
  fn area(self) -> float { return 3.0 * self.r * self.r; }
  fn name(self) -> string { return "circle"; }
}

impl Shape for Rect {
  fn area(self) -> float { return self.w * self.h; }
  fn name(self) -> string { return "rect"; }
}

impl Ord for Circle {
  fn compare(self, other: Circle) -> int {
    if self.r < other.r { return -1; }
    if self.r > other.r { return 1; }
    return 0;
  }
}

impl Ord for int {
  fn compare(self, other: int) -> int { return self - other; }
}

impl<T> Stack<T> {
  fn push(self, x: T) { push(self.items, x); }
  fn size(self) -> int { return len(self.items); }
  fn top(self) -> T? {
    if len(self.items) == 0 { return null; }
    return self.items[len(self.items) - 1];
  }
}

impl Light {
  fn brightness(self) -> int {
    return match self { Off => 0, On(level) => level };
  }
}

fn total(shapes: [Shape]) -> float {
  let sum = 0.0;
  for s in shapes { sum = sum + s.area(); }
  return sum;
}

fn largest<T: Ord>(xs: [T]) -> T {
  let best = xs[0];
  for x in xs {
    if x.compare(best) > 0 { best = x; }
  }
  return best;
}

fn describe<T: Shape>(x: T) -> string {
  return x.name() + " of area " + str(x.area());
}

fn main() {
  let c = new Circle { r: 1.0 };
  print(c.grow(2.0).area());
  let shapes: [Shape] = [];
  push(shapes, c);
  push(shapes, new Rect { w: 2.0, h: 3.0 });
  print(total(shapes));
  for s in shapes { print(s.name()); }
  print(largest([4, 17, 9]));
  print(largest([c, new Circle { r: 5.0 }, new Circle { r: 2.0 }]).r);
  print(describe(new Rect { w: 1.5, h: 2.0 }));
  let words = new Stack { items: ["a"] };
  words.push("b");
  print(str(words.size()) + " " + words.top()!);
  print(Light::On(7).brightness() + Light::Off.brightness());
}
// expect: 12
// expect: 9
// expect: circle
// expect: rect
// expect: 17
// expect: 5
// expect: rect of area 3
// expect: 2 b
// expect: 7
