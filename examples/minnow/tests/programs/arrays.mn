// Arrays, nested arrays, strings and sorting.
fn sort(xs: [int]) {
  let i = 1;
  while i < len(xs) {
    let j = i;
    while j > 0 && xs[j - 1] > xs[j] {
      let t = xs[j];
      xs[j] = xs[j - 1];
      xs[j - 1] = t;
      j = j - 1;
    }
    i = i + 1;
  }
}

fn join(xs: [int], sep: string) -> string {
  let s = "";
  let first = true;
  for x in xs {
    if !first { s = s + sep; }
    s = s + str(x);
    first = false;
  }
  return s;
}

fn main() {
  let xs = [5, 3, 9, 1, 7];
  sort(xs);
  print(join(xs, ", "));
  print(pop(xs));
  print(len(xs));

  let grid: [[int]] = [];
  for r in [0, 1, 2] {
    let row: [int] = [];
    for c in [0, 1, 2] { push(row, r * 3 + c); }
    push(grid, row);
  }
  print(grid[2][1]);

  let words = ["pear", "apple", "fig"];
  let shortest = words[0];
  for w in words {
    if len(w) < len(shortest) { shortest = w; }
  }
  print(shortest);
  print("apple" < "pear");
  print("tab\tand \"quotes\"");
  let empty = [];
  push(empty, true);
  print(empty[0] == true);
}
// expect: 1, 3, 5, 7, 9
// expect: 9
// expect: 4
// expect: 7
// expect: fig
// expect: true
// expect: tab	and "quotes"
// expect: true
