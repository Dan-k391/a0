// expect: bytes
// expect: -41
// expect: error: not an integer
// expect: error: integer out of range
// expect: 25
// expect: true
// expect: 9
// expect: 9 0.5 4
// expect: true
// expect: true
// expect: one,two
// expect: b.txt notes.txt
// expect: true
// expect: false
// expect: true
