// A runtime error says what failed, with the values, and where: the small helpers are inlined
// into `main`, and still have frames of their own.
fn at(xs: [int], i: int) -> int {
  return xs[i];
}

fn last(xs: [int]) -> int {
  return at(xs, len(xs));
}

fn main() {
  let xs = [3, 1, 4];
  print(at(xs, 0));
  print(last(xs));
}
