# Loops: compound interest, a table of squares and a countdown.
let total = 1000
repeat 10 {
  total = total * 1.05
}
print "after ten years:", round(total)

let i = 1
while i <= 4 {
  print i, i * i
  i = i + 1
}

let n = 3
repeat n {
  print n
  n = n - 1
}
if n == 0 { print "liftoff" } else if n < 0 { print "too far" } else { print "not yet" }
# expect-stdout:
# after ten years: 1629
# 1 1
# 2 4
# 3 9
# 4 16
# 3
# 2
# 1
# liftoff
